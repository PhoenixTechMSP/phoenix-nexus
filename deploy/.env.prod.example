# Copier en deploy/.env (ce fichier est ignore par git) puis remplir.
DOMAIN=nexus.votre-societe.be
ACME_EMAIL=ops@votre-societe.be

# Compte administrateur du premier demarrage (12 caracteres minimum pour le mot de passe).
# Laisser vide : un compte admin@phoenix-nexus.local est cree avec un mot de passe aleatoire, affiche une seule fois dans les journaux.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Facultatif. Vide : un secret fort est genere et conserve automatiquement. Pour le fixer : openssl rand -hex 32
JWT_SECRET=

# 1 = charge des donnees d'exemple fictives pour essayer (a laisser a 0 en production reelle).
SEED_SAMPLE=0
