# Copier en deploy/.env (ce fichier est ignore par git) puis remplir.
DOMAIN=demo.phoenix-tech.be
ACME_EMAIL=ops@phoenix-tech.be

# Secret de signature des sessions. Generer avec :  openssl rand -hex 32
JWT_SECRET=

# Mot de passe des comptes de demo : il est AFFICHE PUBLIQUEMENT sur la page de connexion.
# N'y mettre aucun mot de passe reel. 8 caracteres minimum.
DEMO_PASSWORD=

# Compte administrateur PRIVE (optionnel mais recommande pour l'exploitation). Mot de passe : 12 caracteres minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=
