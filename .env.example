# ------------------------------------------------------------------
# Phoenix-Nexus - environment configuration
# Copy to .env and edit before first run
# ------------------------------------------------------------------

# Required: signing key for local JWT sessions (32+ chars)
# Generate: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

PORT=8080
TZ=Europe/Brussels

# ------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) SSO - OPTIONAL
# Leave SSO_ENABLED=false to disable SSO entirely (local login only).
# MFA / Yubikey / Authenticator is enforced by Microsoft Conditional Access.
# ------------------------------------------------------------------
SSO_ENABLED=false

# App registration values (Entra admin center → App registrations)
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Must EXACTLY match the "Redirect URI (Web)" configured on the app registration.
# Examples:
#   http://localhost:8080/api/sso/callback           (local test)
#   https://ptx.intranet.local/api/sso/callback      (intranet deployment)
SSO_REDIRECT_URI=http://localhost:8080/api/sso/callback

# Comma-separated list of email domains allowed to log in via SSO (optional; empty = any).
SSO_ALLOWED_DOMAINS=company.com

# Role assigned to a user on first SSO login: pending | staff | manager | admin
# Recommended: "pending" - an existing admin approves them in Admin → Users.
SSO_DEFAULT_ROLE=pending
